{
  "jobs": [
    {
      "label": "com.elzup.launchd-health",
      "purpose": "台帳のジョブの失敗・未登録を検知して Slack に通知 (朝のジョブ群が走り終わった 10:30)",
      "managed": true,
      "program": ["~/.n/bin/node", "launchd/cli.ts", "health", "--notify"],
      "workdir": "~/.ghq/github.com/elzup/minutely",
      "envFile": "~/.ghq/github.com/elzup/minutely/.envrc",
      "schedule": { "kind": "calendar", "hour": 10, "minute": 30 }
    },
    {
      "label": "com.elzup.morning-news",
      "purpose": "7:00 に trending / JS ニュースをブラウザで開く",
      "managed": true,
      "program": ["~/.n/bin/node", "jobs/morningNews.ts"],
      "workdir": "~/.ghq/github.com/elzup/minutely",
      "schedule": { "kind": "calendar", "hour": 7, "minute": 0 }
    },
    { "label": "com.elzup.forge", "purpose": "マシン状態の計測 (60 秒)", "managed": false, "scheduler": "launchd", "owner": "forge" },
    { "label": "com.elzup.forge-publish", "purpose": "viewer データ差し替え (5 分)", "managed": false, "scheduler": "launchd", "owner": "forge" },
    { "label": "com.elzup.forge-rotate", "purpose": "ログのローテート (4:17)", "managed": false, "scheduler": "launchd", "owner": "forge" },
    { "label": "com.elzup.quota", "purpose": "余剰クォータの burn (15 分)", "managed": false, "scheduler": "launchd", "owner": "quota" },
    { "label": "com.elzup.quota.web", "purpose": "quota の dev サーバー (常駐)", "managed": false, "scheduler": "launchd", "owner": "quota" },
    { "label": "com.elzup.daily-report-ai", "purpose": "リポジトリ活動の AI 日報 (0:00)", "managed": false, "scheduler": "launchd", "owner": "daily-report-ai" },
    { "label": "com.elzup.daily-check", "purpose": "Mensa 募集チェック (10:00)", "managed": false, "scheduler": "launchd", "owner": "daily-check" },
    { "label": "com.elzup.999.sync", "purpose": "999 の日次 sync (9:00)", "managed": false, "scheduler": "launchd", "owner": "999" },
    { "label": "com.elzup.bayalhost", "purpose": "static preview の Caddy (常駐)", "managed": false, "scheduler": "launchd", "owner": "bayalhost" },
    { "label": "com.elzup.bayalhost-admin", "purpose": "bayalhost の管理サーバー (常駐)", "managed": false, "scheduler": "launchd", "owner": "bayalhost" },
    { "label": "sync.dotfiles", "purpose": "dotfiles の同期 (6:00)", "managed": false, "scheduler": "launchd", "owner": "~/dotfiles" },
    { "label": "dump.brewfile", "purpose": "Brewfile のバックアップ (6:00)", "managed": false, "scheduler": "launchd", "owner": "~/Brewfile" },
    { "label": "night-openpaper", "purpose": "夜に論文を開く (21:00)。スクリプト消失", "managed": false, "scheduler": "launchd", "owner": "~/Brewfile", "isDead": true },
    { "label": "setenv", "purpose": "ログイン時に GUI アプリ向けの環境変数を設定", "managed": false, "scheduler": "launchd", "owner": "~/Brewfile" },
    { "label": "PocketFarmVirtual", "purpose": "pocketfarm-virtual の debug ビルドをログイン時に起動", "managed": false, "scheduler": "launchd", "owner": "planckunits/pocketfarm-virtual" },
    { "label": "com.github.facebook.watchman", "purpose": "watchman が自動生成した常駐 (ファイル監視)", "managed": false, "scheduler": "launchd", "owner": "watchman" },
    { "label": "cron:vscode-theme", "purpose": "VSCode テーマ切替 (crontab 0:00)", "managed": false, "scheduler": "cron", "owner": "kit-sh" }
  ]
}
